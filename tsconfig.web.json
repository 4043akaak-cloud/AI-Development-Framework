{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
    "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/shared/boardTypes.ts", "src/shared/controlPlaneTypes.ts", "src/shared/foundationPolicy.ts", "src/shared/projectRegistry.ts", "src/shared/threadTypes.ts", "src/shared/jobLoopTypes.ts", "src/shared/implementationTypes.ts"]
}
